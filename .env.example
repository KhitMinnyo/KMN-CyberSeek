# KMN-CyberSeek Environment Configuration
# Copy this file to .env and update values as needed

# AI Configuration
AI_PROVIDER=api  # Options: "local" for Ollama, "api" for DeepSeek API (recommended)
DEEPSEEK_API_KEY=your_deepseek_api_key_here  # Required if using API provider

# Maximum tokens for a single AI reply. The reply carries reasoning + the next
# command as JSON; too small a value truncates the JSON mid-reply, which the loop
# then mistakes for an "empty command" and stalls. Default 4096.
AI_MAX_TOKENS=4096
# Sampling temperature for tactical command selection. Lower = more deterministic,
# fewer hallucinated flags/CVEs/hostnames. Default 0.2. (The strategist/critique
# passes use their own lower temperature.)
TACTICAL_TEMPERATURE=0.2

# Ollama endpoint - set this to wherever your Ollama instance is running.
# Running KMN-CyberSeek on Kali but Ollama on a Mac (or any other host)?
# Set this to that machine's LAN IP, e.g. http://192.168.1.50:11434
# Make sure Ollama is bound to 0.0.0.0 on the host (OLLAMA_HOST=0.0.0.0 ollama serve)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:8b
# Context window (tokens) for the Ollama model.
# Set this to match your model's num_ctx — the system auto-selects a compact
# system prompt and scales command-output truncation accordingly.
# Common values: 4096 (small/fast), 8192 (default), 32768 (large), 131072 (huge)
# If unset, defaults to 8192.
OLLAMA_CONTEXT_WINDOW=8192

# --- API Authentication ---
# Shared secret required on every backend API request (header: X-API-Key).
# Auto-generated and written here by main.py on first run if left blank -
# you normally don't need to set this by hand. Keep it secret; never commit
# your real .env file (it is gitignored).
API_AUTH_TOKEN=

# --- Network Binding ---
# SECURITY: the API can execute shell commands on behalf of a session, so only
# change this to 0.0.0.0 (or another interface) if you understand that anyone
# who can reach this host and port - and who has API_AUTH_TOKEN - can run
# pentest tooling through it. Defaults to localhost-only.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=6000

# --- Scope Allowlist (optional) ---
# Comma-separated IPs/CIDRs/hostnames that new sessions are allowed to target.
# Leave empty to allow any target (default - solo/homelab use). Example:
# SCOPE_ALLOWLIST=10.0.0.0/8,lab.local,*.lab.local
SCOPE_ALLOWLIST=

# Security Settings
DEFAULT_RISK_THRESHOLD=medium  # low, medium, high
AUTO_APPROVE_LOW_RISK=true
MAX_AUTO_DEPTH=25  # Consecutive auto-executed commands before a manual checkpoint (resets on any critical finding)

# Consecutive auto-pivots (marking a vector exhausted and switching) allowed before
# the session halts for manual review. Higher suits targets with many services.
MAX_AUTO_PIVOTS=12

# Network Settings
SCAN_TIMEOUT=300  # Seconds
MAX_CONCURRENT_SCANS=3
COMMAND_TIMEOUT=600  # Seconds - max runtime for a single executed command

# --- Reverse-shell callback routing (real-world / VPS targets) ---
# A reverse shell only works if the TARGET can route back to your listener.
# On a LAN lab the local IP is reachable; against an internet target behind NAT
# a private IP is NOT reachable and the shell never arrives. Pick how the callback
# address is advertised to the target:
#   auto   - EXPLOIT_LHOST set -> manual; else public target + ngrok -> ngrok;
#            else public target -> public IP; else local. (default)
#   local  - advertise the LAN IP (labs, or operator on a public VPS)
#   public - advertise this host's public egress IP (needs LPORT port-forwarded here)
#   ngrok  - start an ngrok TCP tunnel to LPORT (works from behind NAT, no forward)
#   manual - advertise EXPLOIT_LHOST:EXPLOIT_LPORT (use with a reverse-SSH tunnel:
#            ssh -R 4444:localhost:4444 user@vps  then EXPLOIT_LHOST=<vps_ip>)
CALLBACK_MODE=auto
# EXPLOIT_LHOST=            # explicit callback host (VPS public IP / tunnel endpoint)
# EXPLOIT_LPORT=4444        # callback port (also the local listener port)
# EXPLOIT_PAYLOAD=          # override the auto-guessed msf payload
# NGROK_AUTHTOKEN=          # required for CALLBACK_MODE=ngrok (or run 'ngrok config add-authtoken')

# --- Vulnerability Intelligence (optional) ---
# CVE/CVSS enrichment for discovered services via the Vulners API, on top of
# Nmap's built-in vuln scripts (core/cve_lookup.py). Leave blank to skip -
# findings still work without it, just without CVE matching. Get a key at
# https://vulners.com/api-keys (note: the precise CPE-based matching endpoint
# may require a paid plan; this integration uses Vulners' general search API).
VULNERS_API_KEY=

# CVE exploitability ranking: findings are ranked by CISA KEV (exploited in the
# wild) + FIRST EPSS (exploit probability) so the AI weaponises real threats first
# (no key needed). For the top CVEs, the local msfconsole is queried for a ready
# Metasploit module and the path is shown to the AI.
MSF_CVE_RESOLVE=true       # set false to skip msfconsole CVE->module resolution
MSF_CVE_RESOLVE_LIMIT=3    # how many top-priority CVEs to resolve per pass
# MSF_SEARCH_TIMEOUT=30    # seconds per msfconsole search

# --- OSINT stage hold (public domain/host targets) ---
# Keeps a domain/host target in the OSINT stage until real open-source recon has
# run, so OSINT is not skipped after a single turn. Advances once enough OSINT
# tools have run, or the turn cap is reached.
OSINT_MIN_ACTIONS=3        # distinct OSINT tools before leaving OSINT
OSINT_MAX_TURNS=6          # hard cap so a low-OSINT target still advances

# Database Settings
DB_PATH=kmn_cyberseek.db

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
LOG_FILE=backend.log
# All backend terminal output is mirrored to this single .txt file. It is
# TRUNCATED (overwritten) on every startup — one rolling log for the current run,
# not a new file per run. Set a path/name here to change it.
TERMINAL_LOG_FILE=terminal_output.txt

# Development Settings
DEBUG=false
RELOAD=false

# --- Full Autonomous Mode (OPERATOR USE ONLY) ---
# When true, the AI executes ALL suggested commands without human approval,
# regardless of risk level, keyword backstop, or binary allowlist.
# session.authorization_confirmed must still be True before ANY session starts
# (this is the only gate that remains; it cannot be bypassed).
# Set to true only on fully isolated/lab networks you own or have written
# authorization to test.
FULL_AUTO_MODE=false

# Tool Paths (if not in system PATH)
# NMAP_PATH=/usr/bin/nmap
# METASPLOIT_PATH=/usr/bin/msfconsole
