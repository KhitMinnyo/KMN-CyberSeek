# KMN-CyberSeek Environment Configuration
# Copy this file to .env and update values as needed

# AI Configuration
AI_PROVIDER=local  # Options: "local" for Ollama, "api" for DeepSeek API
DEEPSEEK_API_KEY=your_deepseek_api_key_here  # Required if using API provider

# --- API Authentication ---
# Shared secret required on every backend API request (header: X-API-Key).
# Auto-generated and written here by main.py on first run if left blank -
# you normally don't need to set this by hand. Keep it secret; never commit
# your real .env file (it is gitignored).
API_AUTH_TOKEN=

# --- Network Binding ---
# SECURITY: the API can execute shell commands on behalf of a session, so only
# change this to 0.0.0.0 (or another interface) if you understand that anyone
# who can reach this host and port - and who has API_AUTH_TOKEN - can run
# pentest tooling through it. Defaults to localhost-only.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# --- Scope Allowlist (optional) ---
# Comma-separated IPs/CIDRs/hostnames that new sessions are allowed to target.
# Leave empty to allow any target (default - solo/homelab use). Example:
# SCOPE_ALLOWLIST=10.0.0.0/8,lab.local,*.lab.local
SCOPE_ALLOWLIST=

# Security Settings
DEFAULT_RISK_THRESHOLD=medium  # low, medium, high
AUTO_APPROVE_LOW_RISK=true
MAX_AUTO_DEPTH=5  # Maximum consecutive auto-executed commands

# Network Settings
SCAN_TIMEOUT=300  # Seconds
MAX_CONCURRENT_SCANS=3
COMMAND_TIMEOUT=600  # Seconds - max runtime for a single executed command

# Database Settings
DB_PATH=kmn_cyberseek.db

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
LOG_FILE=backend.log

# Development Settings
DEBUG=false
RELOAD=false

# Port Configuration
BACKEND_PORT=8000
FRONTEND_PORT=8501

# Tool Paths (if not in system PATH)
# NMAP_PATH=/usr/bin/nmap
# METASPLOIT_PATH=/usr/bin/msfconsole
