# KMN-CyberSeek Environment Configuration
# Copy this file to .env and update values as needed

# AI Configuration
AI_PROVIDER=local  # Options: "local" for Ollama, "api" for DeepSeek API
DEEPSEEK_API_KEY=your_deepseek_api_key_here  # Required if using API provider

# Ollama endpoint - set this to wherever your Ollama instance is running.
# Running KMN-CyberSeek on Kali but Ollama on a Mac (or any other host)?
# Set this to that machine's LAN IP, e.g. http://192.168.1.50:11434
# Make sure Ollama is bound to 0.0.0.0 on the host (OLLAMA_HOST=0.0.0.0 ollama serve)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:8b
# Context window (tokens) for the Ollama model.
# Set this to match your model's num_ctx — the system auto-selects a compact
# system prompt and scales command-output truncation accordingly.
# Common values: 4096 (small/fast), 8192 (default), 32768 (large), 131072 (huge)
# If unset, defaults to 8192.
OLLAMA_CONTEXT_WINDOW=8192

# --- API Authentication ---
# Shared secret required on every backend API request (header: X-API-Key).
# Auto-generated and written here by main.py on first run if left blank -
# you normally don't need to set this by hand. Keep it secret; never commit
# your real .env file (it is gitignored).
API_AUTH_TOKEN=

# --- Network Binding ---
# SECURITY: the API can execute shell commands on behalf of a session, so only
# change this to 0.0.0.0 (or another interface) if you understand that anyone
# who can reach this host and port - and who has API_AUTH_TOKEN - can run
# pentest tooling through it. Defaults to localhost-only.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# --- Scope Allowlist (optional) ---
# Comma-separated IPs/CIDRs/hostnames that new sessions are allowed to target.
# Leave empty to allow any target (default - solo/homelab use). Example:
# SCOPE_ALLOWLIST=10.0.0.0/8,lab.local,*.lab.local
SCOPE_ALLOWLIST=

# Security Settings
DEFAULT_RISK_THRESHOLD=medium  # low, medium, high
AUTO_APPROVE_LOW_RISK=true
MAX_AUTO_DEPTH=5  # Maximum consecutive auto-executed commands

# Network Settings
SCAN_TIMEOUT=300  # Seconds
MAX_CONCURRENT_SCANS=3
COMMAND_TIMEOUT=600  # Seconds - max runtime for a single executed command

# --- Vulnerability Intelligence (optional) ---
# CVE/CVSS enrichment for discovered services via the Vulners API, on top of
# Nmap's built-in vuln scripts (core/cve_lookup.py). Leave blank to skip -
# findings still work without it, just without CVE matching. Get a key at
# https://vulners.com/api-keys (note: the precise CPE-based matching endpoint
# may require a paid plan; this integration uses Vulners' general search API).
VULNERS_API_KEY=

# Database Settings
DB_PATH=kmn_cyberseek.db

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
LOG_FILE=backend.log

# Development Settings
DEBUG=false
RELOAD=false

# --- Full Autonomous Mode (OPERATOR USE ONLY) ---
# When true, the AI executes ALL suggested commands without human approval,
# regardless of risk level, keyword backstop, or binary allowlist.
# session.authorization_confirmed must still be True before ANY session starts
# (this is the only gate that remains; it cannot be bypassed).
# Set to true only on fully isolated/lab networks you own or have written
# authorization to test.
FULL_AUTO_MODE=false

# Port Configuration
BACKEND_PORT=8000
FRONTEND_PORT=8501

# Tool Paths (if not in system PATH)
# NMAP_PATH=/usr/bin/nmap
# METASPLOIT_PATH=/usr/bin/msfconsole
